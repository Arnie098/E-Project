{
  "expo": {
    "name": "MANAYUN BAGOBO",
    "slug": "manayun-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "manayun",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f766e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.manayun.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow MANAYUN BAGOBO to access your photos so you can attach images to the AI assistant."
      }
    },
    "android": {
      "package": "com.manayun.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0f766e"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MANAYUN BAGOBO to access your photos so you can attach images to the AI assistant."
        }
      ]
    ]
  }
}
